# Environment Variables for KNOWFLOW (Rapid Knowledge Internalization)
# Copy this file to .env.local and also set these in Vercel Project Settings -> Environment Variables

# 1. Grok API Key (xAI) - Used exclusively for context-grounded 5-stage tutoring, extraction, and quiz grading
GROK_API_KEY=your_grok_api_key_here

# 2. Firebase Web App Config (from Firebase Console -> Project Settings -> General -> Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
